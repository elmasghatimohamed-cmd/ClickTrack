<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           https://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="publisherRepository"
          class="ma.clicktrack.repository.implementation.PublisherRepositoryImpl"/>

    <bean id="publisherService"
          class="ma.clicktrack.service.implementation.PublisherServiceImpl">
        <constructor-arg ref="publisherRepository"/>
        <constructor-arg ref="linkService"/>
    </bean>

    <bean id="linkRepository"
          class="ma.clicktrack.repository.implementation.LinkRepositoryImpl" />
   <bean id="linkService"
         class="ma.clicktrack.service.implementation.LinkServiceImpl">
       <constructor-arg ref="linkRepository" />
       <constructor-arg ref="publisherRepository"/>
   </bean>

    <bean id="dataInitializer"
          class="ma.clicktrack.config.DataInitializer"
          init-method="init">
        <constructor-arg ref="publisherService"/>
    </bean>
</beans>
